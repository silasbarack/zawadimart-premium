# --- Core ---
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://zawadi:zawadi@localhost:5432/zawadimart
# Set to true when connecting to a Postgres that requires TLS (e.g. Render external URL)
DATABASE_SSL=false
# Postgres schema for ZawadiMart's tables. Use a dedicated schema (e.g. zawadimart)
# when the database is shared with another app.
DATABASE_SCHEMA=public
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
# Where the storefront lives (used for card payment redirects)
FRONTEND_URL=http://localhost:5173
# Public https URL of this API (used for M-Pesa callbacks)
PUBLIC_API_URL=http://localhost:4000

# --- Pricing (KES) ---
DELIVERY_FEE=350
FREE_DELIVERY_THRESHOLD=10000
# Unpaid M-Pesa / card orders are cancelled and restocked after this many minutes
PAYMENT_TIMEOUT_MINUTES=30

# Development only: mark M-Pesa and card payments as paid instantly.
# Refused when NODE_ENV=production.
PAYMENT_SIMULATION=false

# Test mode for M-Pesa that also works on the live site: no prompt is sent, no money
# moves, and payments confirm themselves after a few seconds. Checkout shows a clear
# test-mode notice. Real Daraja keys below take priority over this.
MPESA_MOCK=false

# --- M-PESA Daraja (STK Push) ---
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# CustomerPayBillOnline (paybill) or CustomerBuyGoodsOnline (till)
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Till number when using CustomerBuyGoodsOnline; defaults to MPESA_SHORTCODE
MPESA_PARTY_B=
# Random secret embedded in the callback URL so only Safaricom knows it
MPESA_CALLBACK_SECRET=change-me

# --- Paystack (Visa / Mastercard hosted checkout) ---
PAYSTACK_SECRET_KEY=

# --- Order and payment emails ---
# Customers get a branded email when an order is confirmed, a payment is received or fails
# (with the reason), and when an order is cancelled. Set RESEND_API_KEY or SMTP_HOST to turn
# emails on; with neither, emails are off.
#
# Resend (resend.com) sends over HTTPS, so it works on hosts that block mail ports, such as
# Render's free plan. MAIL_FROM must use a domain verified in Resend; until then use
# "ZawadiMart <onboarding@resend.dev>", which only delivers to your own Resend account email.
# When set, it is used instead of SMTP.
RESEND_API_KEY=
#
# SMTP (needs a host that allows outgoing mail ports).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=your Gmail address,
#        SMTP_PASS=an App Password (Google Account > Security > App passwords).
SMTP_HOST=
SMTP_PORT=587
# true for port 465; defaults to true when SMTP_PORT is 465
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Sender shown to customers, e.g. ZawadiMart <orders@yourdomain.com>. Defaults to SMTP_USER.
MAIL_FROM=
# Where customer replies go (optional)
MAIL_REPLY_TO=

# --- Seed admin (created by `npm run seed` if both are set) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
